# Server
# 5000 conflicts with macOS AirPlay Receiver on many Macs — 5050 avoids that.
PORT=5050
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/trading-journal

# CORS
CLIENT_ORIGIN=http://localhost:5173

# AI (all optional — app must run fully without these)
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Market data (optional — Replay price charts and Backtesting require this)
# No provider is implemented yet; this app never fabricates historical
# price data. Set to a real provider key once one is wired up in
# server/src/services/marketDataService.js.
MARKET_DATA_PROVIDER=none
