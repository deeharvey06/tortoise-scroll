{
  "name": "tortoise-scroll-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "predev": "node scripts/ensureLocalEnv.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write . --ignore-unknown --ignore-path ../.gitignore",
    "test": "node --test tests/*.test.js",
    "test-watch": "node --test --watch tests/*.test.js",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "cluster": "pm2 start server.js -i max",
    "seed": "node scripts/seed.js",
    "migrate:ownership": "node scripts/migrateOwnership.js",
    "smoke": "node scripts/apiSmokeTest.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-functions=70 --test-coverage-branches=85 tests/*.test.js",
    "reset:test-db": "node scripts/resetTestDatabase.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/*.{ts,tsx}": "eslint",
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": "prettier -w -u"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  }
}
